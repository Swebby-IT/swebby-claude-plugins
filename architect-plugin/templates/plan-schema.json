{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Architect Plan Schema",
  "description": "Schema JSON per piani di implementazione generati dal plugin Architect",
  "type": "object",
  "required": ["metadata", "content"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["title", "created_at", "version"],
      "properties": {
        "title": {
          "type": "string",
          "description": "Titolo del piano"
        },
        "description": {
          "type": "string",
          "description": "Breve descrizione dell'obiettivo"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Data e ora di creazione"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Data e ora ultima modifica"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
          "description": "Versione del piano (semver)"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "review", "approved", "in_progress", "completed", "cancelled"],
          "description": "Stato del piano"
        },
        "author": {
          "type": "string",
          "description": "Autore del piano"
        },
        "reviewers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Lista reviewer"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tag per categorizzazione"
        }
      }
    },
    "content": {
      "type": "object",
      "required": ["objective", "tasks"],
      "properties": {
        "objective": {
          "type": "string",
          "description": "Obiettivo principale del piano"
        },
        "context": {
          "type": "string",
          "description": "Contesto e background"
        },
        "scope": {
          "type": "object",
          "properties": {
            "in_scope": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Cosa e' incluso"
            },
            "out_of_scope": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Cosa e' escluso"
            }
          }
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Assunzioni fatte"
        },
        "architecture": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "description": "Descrizione architettura"
            },
            "diagrams": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["type", "mermaid"],
                "properties": {
                  "id": { "type": "string" },
                  "type": {
                    "type": "string",
                    "enum": ["context", "container", "component", "sequence", "er", "class", "state", "flowchart"]
                  },
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "mermaid": {
                    "type": "string",
                    "description": "Codice Mermaid del diagramma"
                  }
                }
              }
            },
            "components": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "responsibility": { "type": "string" },
                  "technology": { "type": "string" },
                  "dependencies": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "file"],
            "properties": {
              "id": {
                "type": "integer",
                "description": "ID univoco del task"
              },
              "title": {
                "type": "string",
                "description": "Titolo descrittivo"
              },
              "description": {
                "type": "string",
                "description": "Descrizione dettagliata"
              },
              "file": {
                "type": "string",
                "description": "Path del file da modificare"
              },
              "lines": {
                "type": "string",
                "pattern": "^\\d+(-\\d+)?$",
                "description": "Range di linee (es. '45-60' o '45')"
              },
              "action": {
                "type": "string",
                "enum": ["create", "modify", "delete", "rename"],
                "description": "Tipo di azione"
              },
              "complexity": {
                "type": "string",
                "enum": ["trivial", "low", "medium", "high", "very_high"],
                "description": "Complessita' stimata"
              },
              "depends_on": {
                "type": "array",
                "items": { "type": "integer" },
                "description": "ID dei task da cui dipende"
              },
              "changes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": ["add", "modify", "remove"]
                    },
                    "description": { "type": "string" },
                    "old_code": { "type": "string" },
                    "new_code": { "type": "string" }
                  }
                },
                "description": "Modifiche specifiche"
              },
              "notes": {
                "type": "string",
                "description": "Note aggiuntive"
              },
              "status": {
                "type": "string",
                "enum": ["pending", "in_progress", "completed", "blocked", "skipped"],
                "default": "pending"
              }
            }
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["description"],
            "properties": {
              "id": { "type": "string" },
              "description": {
                "type": "string",
                "description": "Descrizione del rischio"
              },
              "probability": {
                "type": "string",
                "enum": ["low", "medium", "high"]
              },
              "impact": {
                "type": "string",
                "enum": ["low", "medium", "high"]
              },
              "mitigation": {
                "type": "string",
                "description": "Strategia di mitigazione"
              },
              "contingency": {
                "type": "string",
                "description": "Piano di contingenza"
              }
            }
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["unit", "integration", "e2e", "manual"]
              },
              "description": { "type": "string" },
              "file": { "type": "string" },
              "priority": {
                "type": "string",
                "enum": ["low", "medium", "high"]
              }
            }
          }
        },
        "rollback": {
          "type": "object",
          "properties": {
            "strategy": {
              "type": "string",
              "description": "Strategia di rollback"
            },
            "steps": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "verdict": {
          "type": "string",
          "enum": ["approved", "approved_with_changes", "needs_revision", "rejected"]
        },
        "feedback": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": {
                "type": "string",
                "enum": ["critical", "high", "medium", "low"]
              },
              "type": {
                "type": "string",
                "enum": ["issue", "suggestion", "question"]
              },
              "description": { "type": "string" },
              "location": { "type": "string" },
              "resolution": { "type": "string" }
            }
          }
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "reviewed_by": { "type": "string" }
      }
    },
    "statistics": {
      "type": "object",
      "properties": {
        "total_tasks": { "type": "integer" },
        "tasks_by_complexity": {
          "type": "object",
          "properties": {
            "trivial": { "type": "integer" },
            "low": { "type": "integer" },
            "medium": { "type": "integer" },
            "high": { "type": "integer" },
            "very_high": { "type": "integer" }
          }
        },
        "total_files": { "type": "integer" },
        "total_risks": { "type": "integer" },
        "estimated_complexity": {
          "type": "string",
          "enum": ["trivial", "low", "medium", "high", "very_high"]
        }
      }
    }
  }
}
